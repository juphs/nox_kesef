# HTTP port for the dashboard
PORT=3000

# mock  -- synthetic tick generator, no external account needed (default)
# deriv -- REAL ticks + REAL order execution against your Deriv account
FEED_MODE=mock

# --- Deriv (only used when FEED_MODE=deriv) ---------------------------------
# Get a token at https://app.deriv.com/account/api-token
#   1. Switch the account selector (top right) to your DEMO account first
#   2. Create a token with "Read" + "Trade" scopes
#   3. Paste it below -- this is what actually makes the bot "live"
DERIV_API_TOKEN=

# 1089 is Deriv's own public example app_id (fine for testing). Register your
# own free one at https://developers.deriv.com/docs/app-registration/ for
# anything beyond casual use.
DERIV_APP_ID=1089

# Leverage used for every Multiplier contract the bot opens. Clamped to
# MAX_LEVERAGE below regardless of what you set here.
DERIV_MULTIPLIER=20

# Safety gate: even with a valid token, the bot REFUSES to place trades on a
# real-money Deriv account unless this is explicitly "true". The check is
# based on Deriv's own `is_virtual` flag from the authorize response, not on
# what this file claims -- so a demo token always works with this left false.
ALLOW_REAL_MONEY_TRADING=false

# --- NVIDIA AI reasoning matrix ----------------------------------------------
# Free key from https://build.nvidia.com. Without one, the AI Health panel
# shows everything OFFLINE and the bot trades on the statistical ensemble
# alone (which is not a fallback hack -- it's a fully functional trading
# signal on its own; the AI matrix adds a reasoning/narration layer on top).
NVIDIA_API_KEY=
LLM_CALL_TIMEOUT_MS=6000

# --- Risk guardrails ---------------------------------------------------------
MAX_DAILY_DRAWDOWN_PCT=2.0
KELLY_FRACTION=0.25
STARTING_BALANCE=10000
# Hard cap on any single position, regardless of what Kelly sizing computes
MAX_POSITION_PCT_OF_BALANCE=5
# Hard cap on DERIV_MULTIPLIER above
MAX_LEVERAGE=30
# Deriv's practical minimum stake per contract
MIN_STAKE=1
# Portfolio-level cap: no more than this many positions open at once,
# across all pairs combined, no matter how many good signals appear
MAX_CONCURRENT_POSITIONS=8
